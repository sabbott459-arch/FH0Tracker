<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
<TextView android:id="@+id/combat_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="FH0Tracker" android:textSize="15sp" android:textStyle="bold" android:paddingBottom="8dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:background="#26353E">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="HEALTH" android:textColor="#FF8C93" android:textSize="12sp" android:gravity="center"/>
<TextView android:id="@+id/hp_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="11" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:gravity="center"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView android:id="@+id/hp_down" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="−" android:textSize="28sp" android:textColor="#FFFFFF" android:gravity="center" android:background="#43535D"/>
<TextView android:layout_width="8dp" android:layout_height="1dp"/>
<TextView android:id="@+id/hp_up" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="+" android:textSize="28sp" android:textColor="#FFFFFF" android:gravity="center" android:background="#43535D"/>
</LinearLayout></LinearLayout>
<TextView android:layout_width="8dp" android:layout_height="1dp"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp" android:background="#26353E">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="SCENARIO XP" android:textColor="#78C5FF" android:textSize="12sp" android:gravity="center"/>
<TextView android:id="@+id/xp_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="0" android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold" android:gravity="center"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
<TextView android:id="@+id/xp_down" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="−" android:textSize="28sp" android:textColor="#FFFFFF" android:gravity="center" android:background="#43535D"/>
<TextView android:layout_width="8dp" android:layout_height="1dp"/>
<TextView android:id="@+id/xp_up" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:text="+" android:textSize="28sp" android:textColor="#FFFFFF" android:gravity="center" android:background="#43535D"/>
</LinearLayout></LinearLayout>
</LinearLayout></LinearLayout>